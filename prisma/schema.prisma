generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// สร้างตารางเก็บยอดวิว
model Analytics {
  id    Int     @id @default(autoincrement())
  name  String  @unique // เช่น 'portfolio_visits'
  count Int     @default(0)
}